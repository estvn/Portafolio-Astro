---
import { educationInformation } from "../content/educationInformation"
---

<section id="educacion" class="section-spacing">
    <div class="container mx-auto px-2 sm:px-6">
        <div class="text-center mb-16" data-reveal="up">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 text-gradient">Educación</h2>
            <p class="text-xl text-white max-w-2xl mx-auto">
                Mi formación académica y certificaciones profesionales
            </p>
        </div>

        <div class="max-w-4xl mx-auto">
            <div class="relative">
                <div class="timeline-line absolute left-2 md:left-1/2 md:-translate-x-1/2 w-1 h-full bg-primary-500"></div>

                {educationInformation.map((item, index) => (
                    <div class="relative flex items-center mb-12 pl-8 md:pl-0" data-reveal={index % 2 === 0 ? "left" : "right"}>
                        {index % 2 === 0 ? (
                        <>
                            <div class="w-full md:w-1/2 md:pr-8 md:text-right">
                            <div class="neomorphism dark:neomorphism-dark p-6 rounded-2xl hover-lift">
                                <h3 class="text-xl font-bold text-white mb-2">{item.title}</h3>
                                <h4 class="text-lg font-semibold mb-2">{item.company}</h4>
                                <p class="text-white mb-3">{item.date}</p>
                                <p class="text-white">{item.description}</p>
{item.certification && (
<a href={item.certification} target="_blank" rel="noopener noreferrer" class="md:hidden inline-flex items-center min-h-11 mt-2 text-white font-semibold underline">
<i class="fas fa-file-pdf mr-2"></i>Ver certificado
</a>
)}
                            </div>
                            </div>
                            <div class="hidden md:block w-1/2 pl-8 text-primary-500 text-4xl">
                            {item.certification ? (
                                <a href={item.certification} target="_blank" rel="noopener noreferrer" title="Ver certificado">
                                <i class="fas fa-file-pdf hover:text-primary-700 transition-colors duration-300"></i>
                                </a>
                            ) : (
                                <i class="fas fa-graduation-cap"></i>
                            )}
                            </div>
                        </>
                        ) : (
                        <>
                            <div class="hidden md:block w-1/2 pr-8 text-right text-primary-500 text-4xl">
                            {item.certification ? (
                                <a href={item.certification} target="_blank" rel="noopener noreferrer" title="Ver certificado">
                                <i class="fas fa-file-pdf hover:text-primary-700 transition-colors duration-300"></i>
                                </a>
                            ) : (
                                <i class="fas fa-graduation-cap"></i>
                            )}
                            </div>
                            <div class="w-full md:w-1/2 md:pl-8">
                            <div class="neomorphism dark:neomorphism-dark p-6 rounded-2xl hover-lift">
                                <h3 class="text-xl font-bold text-white mb-2">{item.title}</h3>
                                <h4 class="text-lg font-semibold mb-2">{item.company}</h4>
                                <p class="text-white mb-3">{item.date}</p>
                                <p class="text-white">{item.description}</p>
{item.certification && (
<a href={item.certification} target="_blank" rel="noopener noreferrer" class="md:hidden inline-flex items-center min-h-11 mt-2 text-white font-semibold underline">
<i class="fas fa-file-pdf mr-2"></i>Ver certificado
</a>
)}
                            </div>
                            </div>
                        </>
                        )}
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>
