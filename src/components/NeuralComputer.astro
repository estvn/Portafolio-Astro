---
// Layer sizes of the network drawn on the monitor: input → hidden → output
const layers = [
  { x: 70, ys: [55, 75, 95], color: "#60a5fa" },
  { x: 120, ys: [45, 65, 85, 105], color: "#22d3ee" },
  { x: 170, ys: [55, 75, 95], color: "#34d399" },
];

// edges[0] = input→hidden, edges[1] = hidden→output
const edges = layers.slice(0, -1).map((from, i) =>
  from.ys.flatMap((y1) => layers[i + 1].ys.map((y2) => ({ x1: from.x, y1, x2: layers[i + 1].x, y2 })))
);

// One training step per 6s loop: forward pass → loss → backpropagation → weight update.
// Each pass reuses the same `travel` keyframes, shifted with animation-delay.
const passes = [
  { cls: "fwd", set: 0, reverse: false, delay: 0 },
  { cls: "fwd", set: 1, reverse: false, delay: 0.9 },
  { cls: "bwd", set: 1, reverse: true, delay: 2.4 },
  { cls: "bwd", set: 0, reverse: true, delay: 3.3 },
];
const output = layers[layers.length - 1];
---

<svg viewBox="0 0 240 160" role="img" aria-label="Computadora mostrando una red neuronal / Computer showing a neural network" class="neural-computer w-full h-auto">
  <!-- Monitor -->
  <rect x="30" y="8" width="180" height="120" rx="10" fill="#0b1426" stroke="#3b82f6" stroke-width="3" />
  <rect x="38" y="16" width="164" height="104" rx="5" fill="#0b1020" />
  <!-- Stand -->
  <rect x="112" y="128" width="16" height="14" fill="#3b82f6" />
  <rect x="85" y="142" width="70" height="8" rx="4" fill="#3b82f6" />

  <!-- Network -->
  <g transform="translate(0 -3)">
    {edges.flat().map((e) => <line class="weight" x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="#3b82f6" stroke-opacity="0.35" stroke-width="1" />)}
    {passes.map((pass) => edges[pass.set].map((e) => (
      <line
        class={`pulse ${pass.cls}`}
        x1={pass.reverse ? e.x2 : e.x1} y1={pass.reverse ? e.y2 : e.y1}
        x2={pass.reverse ? e.x1 : e.x2} y2={pass.reverse ? e.y1 : e.y2}
        pathLength="1"
        style={`animation-delay: ${pass.delay}s`}
      />
    )))}
    {layers.map((layer) => layer.ys.map((y) => <circle cx={layer.x} cy={y} r="5" fill={layer.color} />))}
    {output.ys.map((y) => <circle class="loss" cx={output.x} cy={y} r="6" />)}
  </g>
</svg>

<style>
  .pulse, .loss { opacity: 0; }
  .pulse { stroke-width: 2; stroke-linecap: round; stroke-dasharray: 0.3 2; stroke-dashoffset: 0.3; }
  .fwd { stroke: #22d3ee; }
  .bwd { stroke: #fb923c; }
  .loss { fill: #ef4444; }

  @media (prefers-reduced-motion: no-preference) {
    .pulse { animation: travel 6s linear infinite; }
    .loss { animation: flash 6s ease-in-out infinite 1.8s; }
    .weight { animation: update 6s ease-in-out infinite 4.2s; }
  }

  /* 0–15% of the loop (0.9s): a dash sweeps along the edge */
  @keyframes travel {
    0% { opacity: 0; stroke-dashoffset: 0.3; }
    2% { opacity: 1; }
    13% { opacity: 1; }
    15%, 100% { opacity: 0; stroke-dashoffset: -1; }
  }
  /* output nodes flash red: the loss */
  @keyframes flash {
    0%, 100% { opacity: 0; }
    8% { opacity: 0.9; }
    16% { opacity: 0; }
  }
  /* weights brighten once the gradients arrive: the update */
  @keyframes update {
    0%, 100% { stroke-opacity: 0.35; stroke-width: 1; }
    10% { stroke-opacity: 0.85; stroke-width: 1.6; }
    20% { stroke-opacity: 0.35; stroke-width: 1; }
  }
</style>
