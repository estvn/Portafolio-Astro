---
const { name, icon } = Astro.props as { name: string; icon: string };
---

<div class="flex flex-col items-center group">
  <img
    src={icon}
    alt={`${name} logo`}
    class="tech-icon w-10 h-10 object-contain"
  />
  <span class="mt-2 text-sm font-semibold text-center text-white">
    {name}
  </span>
</div>
