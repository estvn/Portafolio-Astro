---
import Bi from "../Bi.astro";
import TypeTechnology from "./TypeTechnology.astro";
import type { ITypeTechnology } from "../../interfaces/Interface";
import { technologies } from "../../content/technologies";
---

<section id="tecnologias" class="section-spacing">
    <div class="container mx-auto px-2 sm:px-6">
        <div class="text-center mb-16" data-reveal="up">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 text-gradient"><Bi es="Mis Habilidades Técnicas" en="My Technical Skills" /></h2>
            <p class="text-xl text-fg max-w-2xl mx-auto">
                <Bi
                    es="¡Stack tecnológico y herramientas que domino para ofrecerle soluciones innovadoras!"
                    en="The tech stack and tools I use to deliver innovative solutions!"
                />
            </p>
        </div>
        <div class="flex flex-wrap gap-6">
            {
                technologies.map((tech: ITypeTechnology, index: number) => (
                    <TypeTechnology typeTech={tech.type} typeTechEn={tech.type_en} techList={tech.listTechnologies} delay={(index % 3) * 100} />
                ))
            }
        </div>
    </div>
</section>
