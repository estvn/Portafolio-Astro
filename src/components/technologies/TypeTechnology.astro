---
import Bi from "../Bi.astro";
import Technology from "./Technology.astro";
import type { ITechnology } from "../../interfaces/Interface";

const { typeTech, typeTechEn, techList, delay = 0 } = Astro.props;
---
<div data-reveal="up" data-reveal-delay={delay} class="neomorphism p-6 sm:p-8 rounded-2xl grow max-w-full">
  <h3 class="text-2xl font-bold mb-6 text-center text-fg"><Bi es={typeTech} en={typeTechEn} /></h3>
  <div class="flex flex-wrap justify-center items-center gap-6">
    {
      techList.map((tech: ITechnology) => (
        <Technology name={tech.name} icon={tech.icon} />
      ))
    }
  </div>
</div>
