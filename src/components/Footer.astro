---
import Bi from "./Bi.astro";
import { contactInformation } from "../content/contactInformation"

const links = [
  { href: contactInformation.linkedin, icon: "fab fa-linkedin", es: "LinkedIn", en: "LinkedIn" },
  { href: contactInformation.github, icon: "fab fa-github", es: "GitHub", en: "GitHub" },
  { href: `mailto:${contactInformation.email}`, icon: "fas fa-envelope", es: "Correo electrónico", en: "Email" },
];
---
<hr class="my-5">
<footer>
    <div class="container mx-auto px-6">
      <div class="text-center">
          <div class="flex justify-center space-x-6 mb-4">
            {links.map((link) => (
              <a href={link.href}
                target={link.href.startsWith("mailto:") ? undefined : "_blank"}
                rel="noopener noreferrer"
                class="text-fg hover:opacity-70 transition-opacity duration-300 text-3xl hover:scale-110 transform">
                <i class={link.icon} aria-hidden="true"></i>
                <span class="sr-only"><Bi es={link.es} en={link.en} /></span>
              </a>
            ))}
          </div>
          <p class="text-sm text-muted">&copy; {new Date().getFullYear()} Estiven Mejía</p>
      </div>
    </div>
</footer>
