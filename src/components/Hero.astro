---
import Bi from './Bi.astro';
import { contactInformation } from '../content/contactInformation';
import { experienceInformation } from '../content/experienceInformation';
import { technologies } from '../content/technologies';

// Years since the earliest job start (dates look like "Mayo 2022 - Marzo 2025")
const MONTHS = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
const firstStart = Math.min(
    ...experienceInformation.map(({ date }) => {
        const [month, year] = date.split(' - ')[0].toLowerCase().split(' ');
        return new Date(Number(year), MONTHS.indexOf(month)).getTime();
    })
);
const years = Math.floor((Date.now() - firstStart) / (365.25 * 24 * 3600 * 1000));

const stats = [
    { value: years, suffix: '+', es: 'Años de experiencia', en: 'Years of experience' },
    { value: Object.keys(import.meta.glob('../pages/projects/content/*.mdx')).length, suffix: '', es: 'Proyectos', en: 'Projects' },
    { value: technologies.reduce((total, type) => total + type.listTechnologies.length, 0), suffix: '', es: 'Tecnologías', en: 'Technologies' },
];

const socials = [
    { href: contactInformation.linkedin, icon: 'fab fa-linkedin', es: 'LinkedIn de Estiven Mejía', en: "Estiven Mejía's LinkedIn" },
    { href: contactInformation.github, icon: 'fab fa-github', es: 'GitHub de Estiven Mejía', en: "Estiven Mejía's GitHub" },
    { href: `mailto:${contactInformation.email}`, icon: 'fas fa-envelope', es: 'Enviar correo a Estiven Mejía', en: 'Email Estiven Mejía' },
];
---

<section id="index" class="pt-20 pb-10">
    <div class="container mx-auto px-2 sm:px-6 text-center text-fg relative z-10">
        <div class="animate-slide-up">
            <div class="mb-8 animate-float">
                <img src="/assets/img/perfil-photo.jpeg" alt="Estiven Mejia"
                    width="192"
                    height="192"
                    class="profile-image w-36 h-36 sm:w-48 sm:h-48 rounded-full mx-auto border-4 border-accent shadow-2xl hover:scale-110 transition-transform duration-300">
            </div>

            <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold mb-4 animate-slide-in-left">
                Estiven J. <span>Mejía</span>
            </h1>

            <p class="text-xl my-8 max-w-2xl mx-auto text-muted animate-scale-in">
                <Bi es="Ingeniero en sistemas | Data engineer | Backend developer" en="Systems engineer | Data engineer | Backend developer" />
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center animate-slide-up">
                <a href="/assets/archives/CV_Estiven_Mejia_Fullstack.pdf" download="CV_Estiven_Mejia_Fullstack.pdf"
                    onclick="window.open(this.href, '_blank')"
                    class="btn-solid px-8 py-3 rounded-full font-semibold transition-all duration-300 hover:scale-105 hover:shadow-lg">
                    <Bi es="Descargar CV" en="Download CV" />
                </a>
                <a href="#contact" class="btn-outline px-8 py-3 rounded-full font-semibold transition-all duration-300 hover:scale-105">
                    <Bi es="Contactar" en="Contact me" />
                </a>
            </div>

            <div class="flex justify-center gap-6 sm:gap-10 mt-8">
                {stats.map((stat) => (
                    <div>
                        <div class="text-3xl font-bold text-fg" data-count-to={stat.value} data-count-suffix={stat.suffix}>{stat.value}{stat.suffix}</div>
                        <div class="text-sm text-muted"><Bi es={stat.es} en={stat.en} /></div>
                    </div>
                ))}
            </div>

            <div class="flex justify-center space-x-8 mt-8 animate-bounce-slow">
                {socials.map((social) => (
                    <a href={social.href} target={social.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener noreferrer"
                        class="text-fg hover:opacity-70 transition-opacity duration-300 text-3xl hover:scale-125 transform">
                        <i class={social.icon} aria-hidden="true"></i>
                        <span class="sr-only"><Bi es={social.es} en={social.en} /></span>
                    </a>
                ))}
            </div>
        </div>
    </div>
</section>
