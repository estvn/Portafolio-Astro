---
import { contactInformation } from '../content/contactInformation';
import { experienceInformation } from '../content/experienceInformation';
import { technologies } from '../content/technologies';

// Years since the earliest job start (dates look like "Mayo 2022 - Marzo 2025")
const MONTHS = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
const firstStart = Math.min(
    ...experienceInformation.map(({ date }) => {
        const [month, year] = date.split(' - ')[0].toLowerCase().split(' ');
        return new Date(Number(year), MONTHS.indexOf(month)).getTime();
    })
);
const years = Math.floor((Date.now() - firstStart) / (365.25 * 24 * 3600 * 1000));

const stats = [
    { value: years, suffix: '+', label: 'Años de experiencia' },
    { value: Object.keys(import.meta.glob('../pages/projects/content/*.mdx')).length, suffix: '', label: 'Proyectos' },
    { value: technologies.reduce((total, type) => total + type.listTechnologies.length, 0), suffix: '', label: 'Tecnologías' },
];
---

<section id="index" class="pt-20 pb-10">
    <div class="container mx-auto px-2 sm:px-6 text-center text-white relative z-10">
        <div class="animate-slide-up">
            <div class="mb-8 animate-float">
                <img src="/assets/img/perfil-photo.jpeg" alt="Estiven Mejia"
                    width="192"
                    height="192"
                    class="profile-image w-36 h-36 sm:w-48 sm:h-48 rounded-full mx-auto border-4 border-white shadow-2xl hover:scale-110 transition-transform duration-300">
            </div>

            <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold mb-4 animate-slide-in-left">
                Estiven J. <span class="text-white">Mejía</span>
            </h1>

            <p class="text-xl my-8 max-w-2xl mx-auto opacity-90 animate-scale-in">
                Ingeniero en sistemas | Data engineer | Backend developer
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center animate-slide-up">
                <a href="/assets/archives/CV_Estiven_Mejia_Fullstack.pdf" download="CV_Estiven_Mejia_Fullstack.pdf"
                    onclick="window.open(this.href, '_blank')"
                    class="bg-white text-gray-900 px-8 py-3 rounded-full font-semibold hover:bg-gray-100 transition-all duration-300 hover:scale-105 hover:shadow-lg">
                    Descargar CV
                </a>
                <a href="#contact" class="border-2 border-white text-white px-8 py-3 rounded-full font-semibold hover:bg-white hover:text-white/70 transition-all duration-300 hover:scale-105">
                    Contactar
                </a>
            </div>

            <div class="flex justify-center gap-6 sm:gap-10 mt-8">
                {stats.map((stat) => (
                    <div>
                        <div class="text-3xl font-bold text-white" data-count-to={stat.value} data-count-suffix={stat.suffix}>{stat.value}{stat.suffix}</div>
                        <div class="text-sm text-white">{stat.label}</div>
                    </div>
                ))}
            </div>

            <div class="flex justify-center space-x-8 mt-8 animate-bounce-slow">
                <a href={contactInformation.linkedin} class="text-white hover:text-white/70 transition-colors duration-300 text-3xl hover:scale-125 transform">
                    <i class="fab fa-linkedin"></i>
                </a>
                <a href={contactInformation.github} class="text-white hover:text-white/70 transition-colors duration-300 text-3xl hover:scale-125 transform">
                    <i class="fab fa-github"></i>
                </a>
                <a href={`mailto:${contactInformation.email}`} class="text-white hover:text-white/70 transition-colors duration-300 text-3xl hover:scale-125 transform">
                    <i class="fas fa-envelope"></i>
                </a>
            </div>
        </div>
    </div>
</section>
