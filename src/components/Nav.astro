---
import { contactInformation } from '../content/contactInformation';

const socials = [
  { href: contactInformation.linkedin, icon: 'fab fa-linkedin', label: 'LinkedIn de Estiven Mejía', external: true },
  { href: contactInformation.github, icon: 'fab fa-github', label: 'GitHub de Estiven Mejía', external: true },
  { href: `mailto:${contactInformation.email}`, icon: 'fas fa-envelope', label: 'Enviar correo a Estiven Mejía', external: false },
];
---

<nav
  class="fixed top-0 inset-x-0 z-20 h-[var(--nav-h)] pt-[env(safe-area-inset-top)]
         bg-gray-900/80 backdrop-blur-md border-b border-white/10
         flex items-center justify-between px-4 sm:px-8"
>
  <a href="/" class="font-semibold text-white text-lg min-h-11 inline-flex items-center">Estiven Mejía</a>

  <div class="flex items-center">
    {socials.map((social) => (
      <a
        href={social.href}
        aria-label={social.label}
        target={social.external ? '_blank' : undefined}
        rel={social.external ? 'noopener noreferrer' : undefined}
        class="w-11 h-11 inline-flex items-center justify-center text-white hover:text-white text-2xl transition-colors duration-300"
      >
        <i class={social.icon}></i>
      </a>
    ))}
  </div>
</nav>
