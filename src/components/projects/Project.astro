---
import ProjectCard from './ProjectCard.astro';
import type { IProject } from '../../interfaces/Interface';

const projects: IProject[] = (await Astro.glob('../../pages/projects/content/*.mdx')).map(project => project.frontmatter) as IProject[];

const blocks = [
    { title: 'Proyectos', items: projects.filter((project) => project.category === 'work') },
    { title: 'Proyectos académicos y personales', items: projects.filter((project) => project.category === 'personal') },
];
---

<section id="proyectos" class="section-spacing">
    <div class="container mx-auto px-2 sm:px-6">
        {blocks.map((block) => (
        <div class="mb-16 last:mb-0">
            <div class="text-center mb-16" data-reveal="up">
                <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 text-gradient">{block.title}</h2>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                {block.items.map((project, index) => (
                    <div data-reveal="up" data-reveal-delay={(index % 3) * 100}><ProjectCard {...project} /></div>
                ))}
            </div>
        </div>
        ))}
    </div>
</section>
