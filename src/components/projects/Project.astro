---
import Bi from '../Bi.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectCarousel from './ProjectCarousel.astro';
import type { IProject } from '../../interfaces/Interface';

// Astro.glob returns files sorted by path, i.e. by the NNN_ filename prefix
const projects: IProject[] = (await Astro.glob('../../pages/projects/content/*.mdx')).map(project => project.frontmatter) as IProject[];

const VISIBLE_WORK = 4;
const work = projects.filter((project) => project.category === 'work');
const personal = projects.filter((project) => project.category === 'personal');
const academic = projects.filter((project) => project.category === 'academic');
---

<section id="proyectos" class="section-spacing">
    <div class="container mx-auto px-2 sm:px-6">
        <!-- Work projects: first 4 visible, the rest hidden (but in the DOM) until "show more" -->
        <div class="mb-16">
            <div class="text-center mb-16" data-reveal="up">
                <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 text-gradient"><Bi es="Proyectos" en="Projects" /></h2>
            </div>
            <div id="work-projects" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                {work.map((project, index) => (
                    <div data-extra={index >= VISIBLE_WORK ? '' : undefined} hidden={index >= VISIBLE_WORK}>
                        <div data-reveal="up" data-reveal-delay={(index % 3) * 100}><ProjectCard {...project} /></div>
                    </div>
                ))}
                {work.length > VISIBLE_WORK && (
                <!-- lg+ only: skeleton card in the next free grid slot; its button proxies to the bar button below (show-more.js) -->
                <div data-show-more-skeleton="work-projects" class="hidden lg:block">
                    <div class="glass rounded-2xl overflow-hidden h-full relative" data-reveal="up" data-reveal-delay="100">
                        <div aria-hidden="true" class="h-full flex flex-col">
                            <div class="w-full h-48 bg-fg/10"></div>
                            <div class="p-6 flex-1">
                                <div class="h-5 w-4/5 rounded bg-fg/10 mb-2"></div>
                                <div class="h-5 w-3/5 rounded bg-fg/10 mb-5"></div>
                                <div class="h-3 w-full rounded bg-fg/10 mb-2"></div>
                                <div class="h-3 w-full rounded bg-fg/10 mb-2"></div>
                                <div class="h-3 w-2/3 rounded bg-fg/10 mb-5"></div>
                                <div class="flex gap-2 mb-5">
                                    <div class="h-6 w-16 rounded-full bg-fg/10"></div>
                                    <div class="h-6 w-20 rounded-full bg-fg/10"></div>
                                </div>
                                <div class="h-10 w-36 rounded-full bg-fg/10"></div>
                            </div>
                        </div>
                        <div class="absolute inset-0 flex items-center justify-center p-4">
                            <button type="button" data-show-more-proxy="work-projects"
                                class="btn-outline bg-page inline-flex items-center gap-2 min-h-11 px-6 rounded-full font-semibold transition-all duration-300">
                                <i class="fas fa-chevron-down mr-2" aria-hidden="true"></i><Bi es="Mostrar más proyectos" en="Show more projects" />
                            </button>
                        </div>
                    </div>
                </div>
                )}
            </div>
            {work.length > VISIBLE_WORK && (
            <!-- mobile/tablet always; on lg+ only once expanded (show less) -->
            <div data-show-more-bar="work-projects" class="text-center mt-10 lg:hidden">
                <button type="button" data-show-more aria-controls="work-projects" aria-expanded="false"
                    class="btn-outline inline-flex items-center gap-2 min-h-11 px-6 rounded-full font-semibold transition-all duration-300">
                    <span data-label="more"><i class="fas fa-chevron-down mr-2" aria-hidden="true"></i><Bi es="Mostrar más proyectos" en="Show more projects" /></span>
                    <span data-label="less" hidden><i class="fas fa-chevron-up mr-2" aria-hidden="true"></i><Bi es="Mostrar menos" en="Show less" /></span>
                </button>
            </div>
            )}
        </div>

        <!-- Other projects: personal and academic, one carousel each (autoplay handled by carousel.js) -->
        <div>
            <div class="text-center mb-12" data-reveal="up">
                <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 text-gradient">
                    <Bi es="Otros proyectos" en="Other projects" />
                </h2>
            </div>

            <h3 class="text-2xl sm:text-3xl font-bold text-center mb-8" data-reveal="up">
                <Bi es="Proyectos personales" en="Personal projects" />
            </h3>
            <ProjectCarousel projects={personal} label="Proyectos personales / Personal projects" />

            <h3 class="text-2xl sm:text-3xl font-bold text-center mt-20 mb-8" data-reveal="up">
                <Bi es="Proyectos académicos" en="Academic projects" />
            </h3>
            <ProjectCarousel projects={academic} label="Proyectos académicos / Academic projects" />
        </div>
    </div>
</section>
