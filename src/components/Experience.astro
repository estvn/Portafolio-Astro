---
import { experienceInformation } from "../content/experienceInformation"

// **text** in bullets becomes a highlighted span
const bold = (text: string) => text.replace(/\*\*(.+?)\*\*/g, '<strong class="text-gradient">$1</strong>');
---

<section id="experiencia" class="section-spacing">
    <div class="container mx-auto px-2 sm:px-6">
        <div class="text-center mb-16" data-reveal="up">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 text-gradient">Experiencia</h2>
            <p class="text-xl text-white max-w-2xl mx-auto">
                Mi trayectoria profesional
            </p>
        </div>
        
        <div class="max-w-4xl mx-auto">
            <div class="relative">
                <div class="timeline-line absolute left-2 md:left-1/2 md:-translate-x-1/2 w-1 h-full bg-primary-500"></div>
                
                {experienceInformation.map((item, index) => (
                    <div class="relative flex items-center mb-12 pl-8 md:pl-0" data-reveal={index % 2 === 0 ? "left" : "right"}>
                        {index % 2 === 0 ? (
                        <>
                            <div class="w-full md:w-1/2 md:pr-8 text-left">
                            <div class="neomorphism dark:neomorphism-dark p-6 rounded-2xl hover-lift">
                                <h3 class="text-xl font-bold text-white mb-2">{item.title}</h3>
                                <h4 class="text-lg font-semibold mb-2">{item.company}</h4>
                                <p class="text-white mb-3">{item.date}</p>
{item.subtitle && <p class="text-sm text-white/80 mb-3">{item.subtitle}</p>}
                                {item.projects?.map((project) => (
                                    <div class="mt-4 text-left">
                                        <h5 class="font-semibold">{project.name}</h5>
                                        <div class="flex flex-wrap gap-1.5 my-2">
                                            {project.technologies.map((tech) => (
                                                <span class="bg-blue-900 text-white px-2 py-0.5 rounded-full text-xs">{tech}</span>
                                            ))}
                                        </div>
                                        <ul class="space-y-1.5 text-sm">
                                            {project.bullets.map((bullet) => (
                                                <li class="relative pl-4 before:content-[''] before:absolute before:left-0 before:top-2 before:w-1.5 before:h-1.5 before:rounded-full before:bg-primary-500" set:html={bold(bullet)} />
                                            ))}
                                        </ul>
                                    </div>
                                ))}
{item.certification && (
<a href={item.certification} target="_blank" rel="noopener noreferrer" class="md:hidden inline-flex items-center min-h-11 mt-2 text-white font-semibold underline">
<i class="fas fa-file-pdf mr-2"></i>Ver certificado
</a>
)}
                            </div>
                            </div>
                            <div class="hidden md:block w-1/2 pl-8 text-primary-500 text-4xl">
                            {item.certification ? (
                                <a href={item.certification} target="_blank" rel="noopener noreferrer" title="Ver certificado">
                                <i class="fas fa-file-pdf hover:text-primary-700 transition-colors duration-300"></i>
                                </a>
                            ) : (
                                <i class="fas fa-code"></i>
                            )}
                            </div>
                        </>
                        ) : (
                        <>
                            <div class="hidden md:block w-1/2 pr-8 text-right text-primary-500 text-4xl">
                            {item.certification ? (
                                <a href={item.certification} target="_blank" rel="noopener noreferrer" title="Ver certificado">
                                <i class="fas fa-file-pdf hover:text-primary-700 transition-colors duration-300"></i>
                                </a>
                            ) : (
                                <i class="fas fa-code"></i>
                            )}
                            </div>
                            <div class="w-full md:w-1/2 md:pl-8">
                            <div class="neomorphism dark:neomorphism-dark p-6 rounded-2xl hover-lift">
                                <h3 class="text-xl font-bold text-white mb-2">{item.title}</h3>
                                <h4 class="text-lg font-semibold mb-2">{item.company}</h4>
                                <p class="text-white mb-3">{item.date}</p>
{item.subtitle && <p class="text-sm text-white/80 mb-3">{item.subtitle}</p>}
                                {item.projects?.map((project) => (
                                    <div class="mt-4 text-left">
                                        <h5 class="font-semibold">{project.name}</h5>
                                        <div class="flex flex-wrap gap-1.5 my-2">
                                            {project.technologies.map((tech) => (
                                                <span class="bg-blue-900 text-white px-2 py-0.5 rounded-full text-xs">{tech}</span>
                                            ))}
                                        </div>
                                        <ul class="space-y-1.5 text-sm">
                                            {project.bullets.map((bullet) => (
                                                <li class="relative pl-4 before:content-[''] before:absolute before:left-0 before:top-2 before:w-1.5 before:h-1.5 before:rounded-full before:bg-primary-500" set:html={bold(bullet)} />
                                            ))}
                                        </ul>
                                    </div>
                                ))}
{item.certification && (
<a href={item.certification} target="_blank" rel="noopener noreferrer" class="md:hidden inline-flex items-center min-h-11 mt-2 text-white font-semibold underline">
<i class="fas fa-file-pdf mr-2"></i>Ver certificado
</a>
)}
                            </div>
                            </div>
                        </>
                        )}
                    </div>
                ))}

             
            </div>
        </div>
    </div>
</section>
