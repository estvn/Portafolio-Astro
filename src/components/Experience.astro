---
import Bi from "./Bi.astro";
import { experienceInformation } from "../content/experienceInformation"

// **text** in bullets becomes a highlighted span
const bold = (text: string) => text.replace(/\*\*(.+?)\*\*/g, '<strong class="text-gradient">$1</strong>');
---

<section id="experiencia" class="section-spacing">
    <div class="container mx-auto px-2 sm:px-6">
        <div class="text-center mb-16" data-reveal="up">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 text-gradient"><Bi es="Experiencia" en="Experience" /></h2>
            <p class="text-xl text-fg max-w-2xl mx-auto">
                <Bi es="Mi trayectoria profesional" en="My professional journey" />
            </p>
        </div>

        <div class="max-w-6xl mx-auto">
            <div class="relative">
                <div class="timeline-line hidden md:block absolute left-[7px] w-[6px] rounded-full h-full bg-fg"></div>

                {experienceInformation.map((item) => (
                    <div class="relative mb-12 md:pl-12" data-reveal="up">
                        <div class="w-full text-left">
                            <div class="neomorphism p-6 rounded-2xl hover-lift">
                                <h3 class="text-xl font-bold text-fg mb-2"><Bi es={item.title} en={item.title_en} /></h3>
                                <h4 class="text-lg font-semibold mb-2">{item.company}</h4>
                                <p class="text-fg mb-3"><Bi es={item.date} en={item.date_en} /></p>
                                {item.subtitle && <p class="text-sm text-muted mb-3"><Bi es={item.subtitle} en={item.subtitle_en} /></p>}
                                {item.projects?.map((project) => (
                                    <div class="mt-4 text-left">
                                        <h5 class="font-semibold"><Bi es={project.name} en={project.name_en} /></h5>
                                        <div class="flex flex-wrap gap-1.5 my-2">
                                            {project.technologies.map((tech) => (
                                                <span class="bg-chip text-chip-fg px-2 py-0.5 rounded-full text-xs">{tech}</span>
                                            ))}
                                        </div>
                                        <ul class="space-y-1.5 text-sm">
                                            {project.bullets.map((bullet, i) => (
                                                <li class="relative pl-4 before:content-[''] before:absolute before:left-0 before:top-2 before:w-1.5 before:h-1.5 before:rounded-full before:bg-primary-500">
                                                    <Bi html es={bold(bullet)} en={bold(project.bullets_en?.[i] ?? bullet)} />
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                ))}
                                {item.certification && (
                                    <a href={item.certification} target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-11 mt-2 text-accent font-semibold underline">
                                        <i class="fas fa-file-pdf mr-2" aria-hidden="true"></i><Bi es="Ver certificado" en="View certificate" />
                                    </a>
                                )}
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>
