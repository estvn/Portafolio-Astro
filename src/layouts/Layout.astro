---
import "../assets/css/global.css"
import "../assets/css/styles.css"
import Head from "../components/Head.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <Head title={title}/>
  <body class="min-h-dvh flex bg-gray-50 dark:bg-gray-900 text-white transition-colors duration-300">
    <div id="scroll-progress"></div>
    <Nav/>
    <main class="flex-1 w-full px-4 sm:px-8 pb-8 pt-[calc(var(--nav-h)+0.5rem)]">
      <slot/>
      <div class="mt-4 p-2 w-full">
        <Footer />
      </div>
    </main>

<script src="../assets/js/main.js"></script>
    <script>
      import { initEtlBackground } from "../assets/js/etl-background.js";
      import { initReveal } from "../assets/js/reveal.js";
      import { initScrollProgress, initTimelines, initCounters } from "../assets/js/scroll-effects.js";

      initEtlBackground();
      initReveal();
      initScrollProgress();
      initTimelines();
      initCounters();
    </script>
  </body>
</html>
